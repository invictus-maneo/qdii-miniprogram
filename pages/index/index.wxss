.wrap { padding: 32rpx 20rpx 56rpx; }
.header { margin-bottom: 24rpx; }
.title { font-size: 40rpx; font-weight: 700; }
.sub { font-size: 24rpx; color: #6b7785; margin-top: 6rpx; }

.card {
  background: #fff; border: 1rpx solid #e3e8ef; border-radius: 16rpx;
  padding: 36rpx 28rpx; margin-bottom: 28rpx;
  box-shadow: 0 2rpx 6rpx rgba(16,24,40,.04);
}
.field { margin-bottom: 28rpx; }
.label { font-size: 26rpx; font-weight: 600; margin-bottom: 12rpx; }
.hint { font-weight: 400; color: #6b7785; font-size: 22rpx; margin-left: 10rpx; }

/* 产品搜索下拉 */
.combo { position: relative; }
.combo-input {
  width: 100%; padding: 20rpx 22rpx; font-size: 28rpx;
  border: 1rpx solid #e3e8ef; border-radius: 12rpx; background: #fff; color: #1f2933;
}
.combo-input:focus { border-color: #1f6feb; }
.combo-list {
  position: absolute; z-index: 30; left: 0; right: 0; top: calc(100% + 8rpx);
  max-height: 520rpx; overflow-y: auto; background: #fff;
  border: 1rpx solid #e3e8ef; border-radius: 12rpx;
  box-shadow: 0 12rpx 36rpx rgba(16,24,40,.12); padding: 8rpx;
}
.combo-item { padding: 14rpx 18rpx; border-radius: 10rpx; }
.combo-item:active { background: #e8f0fe; }
.combo-item .cid { font-size: 26rpx; font-weight: 600; }
.combo-item .cname { font-size: 24rpx; color: #6b7785; margin-top: 4rpx; line-height: 1.5; word-break: break-all; }
.combo-empty { color: #6b7785; padding: 14rpx 18rpx; font-size: 24rpx; }

/* 日期 / 下拉选择框 */
.row { display: flex; gap: 24rpx; }
.row .field { flex: 1; }
.picker {
  width: 100%; padding: 20rpx 22rpx; font-size: 28rpx; color: #1f2933;
  border: 1rpx solid #e3e8ef; border-radius: 12rpx; background: #fff;
}

/* 快捷区间胶囊 */
.chips { display: flex; flex-wrap: wrap; gap: 14rpx; }
.chip {
  padding: 12rpx 24rpx; font-size: 24rpx; color: #1f2933; background: #fff;
  border: 1rpx solid #e3e8ef; border-radius: 999rpx;
}
.chip.active { background: #1f6feb; border-color: #1f6feb; color: #fff; }

/* 年化 */
.ann-row { display: flex; align-items: center; gap: 24rpx; flex-wrap: wrap; }
.ann-check { display: flex; align-items: center; gap: 12rpx; font-size: 26rpx; color: #6b7785; }
.ann-base { flex: 1; min-width: 360rpx; }

/* 计算按钮 */
.calc-btn {
  width: 100%; padding: 24rpx; font-size: 30rpx; font-weight: 600; color: #fff;
  background: #1f6feb; border-radius: 12rpx; margin-top: 8rpx;
}
.calc-btn:active { background: #1a5fd0; }
.err { color: #d4380d; font-size: 24rpx; margin-top: 20rpx; }

/* 结果 */
.result { margin-top: 36rpx; }
.res-head { font-size: 28rpx; font-weight: 700; padding-bottom: 18rpx; border-bottom: 1rpx solid #e3e8ef; }
.res-main {
  display: flex; align-items: baseline; gap: 18rpx; margin: 24rpx 0 30rpx;
  padding: 28rpx 30rpx; border: 1rpx solid #e3e8ef; border-radius: 16rpx;
  background: linear-gradient(135deg,#f8fafc 0%,#eef3fb 100%);
}
.rate { font-size: 64rpx; font-weight: 800; letter-spacing: -.01em; }
.rate.up { color: #d4380d; }
.rate.down { color: #389e0d; }
.ann { font-size: 24rpx; color: #6b7785; }
.table { width: 100%; }
.tr { display: flex; justify-content: space-between; padding: 16rpx 4rpx; border-bottom: 1rpx solid #e3e8ef; font-size: 26rpx; }
.th { color: #6b7785; }
.td { color: #1f2933; }
.num { font-variant-numeric: tabular-nums; }
.note { font-size: 22rpx; color: #b98900; margin-top: 18rpx; line-height: 1.7; }

/* 说明区 */
.notes-h { font-size: 28rpx; font-weight: 700; margin: 36rpx 0 18rpx; }
.notes-h:first-of-type { margin-top: 0; }
.notes-p { font-size: 24rpx; color: #6b7785; line-height: 1.85; }
.tips { margin: 0; padding: 0; }
.tip { margin-bottom: 30rpx; }
.tip:last-child { margin-bottom: 0; }
.tip-title { display: block; font-size: 26rpx; font-weight: 600; color: #1f2933; margin-bottom: 6rpx; }
.tip-body { display: block; font-size: 24rpx; color: #6b7785; line-height: 1.8; }
.slogan {
  margin-top: 30rpx; padding-top: 24rpx; border-top: 1rpx solid #e3e8ef;
  text-align: center; font-size: 26rpx; font-weight: 600; color: #1f6feb; letter-spacing: .03em;
}

.loading { text-align: center; color: #6b7785; font-size: 26rpx; padding: 40rpx 0; }
